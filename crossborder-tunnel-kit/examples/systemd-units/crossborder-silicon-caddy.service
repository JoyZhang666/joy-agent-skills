[Unit]
Description=Crossborder silicon dedicated HTTPS entrance
After=network-online.target crossborder-silicon-xray.service crossborder-silicon-firewall.service
Requires=crossborder-silicon-firewall.service
Wants=network-online.target

[Service]
User=crossborder-silicon
Group=crossborder-silicon
ExecStart=/opt/crossborder/silicon/current/caddy run --config /opt/crossborder/silicon/current/caddy.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=crossborder-silicon
Environment=XDG_DATA_HOME=/var/lib/crossborder-silicon
Environment=XDG_CONFIG_HOME=/var/lib/crossborder-silicon
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
